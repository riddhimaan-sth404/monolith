root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.rs]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{c,h}]
indent_style = tab
indent_size = 4

[*.proto]
indent_size = 2

[*.toml]
indent_size = 4

[Makefile]
indent_style = tab
