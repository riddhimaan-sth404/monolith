<Window x:Class="MonolithGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monolith Enterprise EDR Console"
        Height="860" Width="1360"
        MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Panel -->
        <Border Grid.Column="0" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="20,20,20,16">
                    <TextBlock Text="MONOLITH" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Endpoint Defense Platform" FontSize="11" Foreground="{StaticResource SubtextBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Grouped Navigation Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" BorderThickness="0">
                    <StackPanel Margin="12,0">
                        <!-- Category 1: Core Protection -->
                        <TextBlock Text="CORE PROTECTION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,8,12,6"/>
                        <RadioButton GroupName="Nav" IsChecked="True" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="0" Content=" Executive Dashboard"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="3" Content=" System &amp; RAM Scanner"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="2" Content=" Threat Alerts &amp; Logs"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="6" Content=" Quarantine Vault"/>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource GlassBorderBrush}" Margin="8,14,8,10"/>

                        <!-- Category 2: Management & Policy -->
                        <TextBlock Text="MANAGEMENT &amp; POLICY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,4,12,6"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="1" Content=" Endpoints &amp; Control"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="5" Content=" Security Policies"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="4" Content=" IoCs &amp; Exclusions"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="7" Content=" Security Reports"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="8" Content=" Admin Tools"/>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="9" Content=" Settings &amp; MFA"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: Connection Status & Sign Out -->
                <Border Grid.Row="2" Margin="12,12,12,16" Padding="12" Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="{Binding ConnectionStatusColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConnectionStatusText}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Content="Sign Out" Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Workspace Workspace Area -->
        <Grid Grid.Column="1" Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Workspace Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SelectedPanelTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Real-time Endpoint Telemetry &amp; Control" FontSize="12" Foreground="{StaticResource SubtextBrush}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10,10-4.48,10-10S17.52,2,12,2zm-2,15l-5-5,1.41-1.41L10,14.17l7.59-7.59L19,8l-9,9z" Fill="{StaticResource SuccessBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="System Shield Active" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Content Panel Area -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
